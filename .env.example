# Optional External LLM Keys (Gemini & OpenAI)
# Leave empty to use the built-in Intelligent Benchmark Simulation Engine
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_LLM_PROVIDER="auto"
